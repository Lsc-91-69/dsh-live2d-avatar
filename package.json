{
  "name": "dsh-live2d-avatar",
  "version": "1.2.0",
  "private": true,
  "description": "DSH bundle: a Live2D desktop pet (WebView2) that shows the Agent's status and inner thoughts",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./engine": "./engine.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host-smoke.mjs && node test/zoom-fit.mjs",
    "test:pet": "node test/pet-coldstart.mjs",
    "check": "node --check host.js && node --check engine.js && node --check entry.js",
    "verify": "npm run check && npm test"
  },
  "files": [
    "entry.js",
    "host.js",
    "engine.js",
    "test",
    "vendor",
    "pet",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
